# Sanjivani University - College Internship Management System (CIMS)
# Production Environment Variables Template

# Environment: 'development', 'staging', 'production'
ENVIRONMENT=production

# Database Configuration
# Default zero-config SQLite:
DATABASE_URL=sqlite:///./cims.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://cims_admin:STRONG_DB_PASSWORD@localhost:5432/sanjivani_cims

# Cryptographic & Session Secrets
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_KEY_IN_PRODUCTION
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_KEY_FOR_REFRESH_TOKENS
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Two-Factor Authentication (TOTP) Encryption Key
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=1JEagI9K_VZ85R4NLCawX9oN_wWzYDHcyF8KO33e9Hs=

# Application URLs
FRONTEND_URL=http://localhost:5173
PROJECT_NAME="Sanjivani University - College Internship Management System (CIMS)"
API_V1_STR=/api/v1

# Institutional Email Provider (Options: 'smtp', 'resend', 'console')
EMAIL_PROVIDER=console
EMAIL_FROM=tpo@sanjivani.edu.in
EMAIL_FROM_NAME="Sanjivani University TPO"

# SMTP Settings (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tpo@sanjivani.edu.in
SMTP_PASSWORD=your_secure_smtp_app_password
SMTP_TLS=true

# Resend API Key (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=["pdf"]

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
