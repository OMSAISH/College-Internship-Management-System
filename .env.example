# College Internship Management System (CIMS) Environment Configuration

# Database Configuration
# Default zero-config SQLite:
DATABASE_URL=sqlite:///./cims.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://cims_user:cims_secure_password_123@localhost:5432/cims_db

# Security & JWT Tokens
SECRET_KEY=cims_super_secret_jwt_production_key_987654321_hex
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Platform Metadata
PROJECT_NAME="College Internship Management System"
API_V1_STR=/api/v1

# File Upload Settings
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=.pdf

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]

# Demo Credentials (Pre-seeded in seed_data.py)
# Admin:   admin@demo.local   / Admin@1234
# Faculty: faculty@demo.local / Faculty@1234
# Student: student@demo.local / Student@1234
